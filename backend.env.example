# Copy to backend.env on each server and fill in real values.
# Server-side only — do NOT commit the filled-in version to git.

# ===== Auth =====
# JWT secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 16 characters; the backend refuses to start otherwise.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=3650

# ===== Database =====
# Defaults to sqlite+aiosqlite:////app/data/txt2img.db (the bind-mounted
# host path ./data/txt2img.db). Override only if you really need a
# different location.
# DB_URL=sqlite+aiosqlite:////app/data/txt2img.db

# ===== Bootstrap admin (created on first startup if missing) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ===== Login / captcha =====
# Force human verification on every login regardless of failure count.
FORCE_CAPTCHA=false

# ===== CORS =====
# "*" = lenient (any origin), otherwise comma-separated list.
# With nginx same-origin proxy this is rarely hit anyway, but "*" lets LAN
# devices that bypass the proxy still talk to the backend.
CORS_ORIGINS=*

# ===== Scheduler =====
# Global cap on concurrent worker slots. The 4 tier lanes share this pool.
SCHEDULER_GLOBAL_MAX_WORKERS=32

# ===== Cloudflare Turnstile =====
# Site key is exposed to the browser; secret stays server-side.
# The values below are Cloudflare's official always-pass test keys —
# fine for local dev / CI screenshots. Replace with real keys before any
# real deployment. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ===== Task retention =====
# Default cutoff for the cleanup job. Admin can override per-run.
JOB_RETENTION_DAYS=30

# ===== Image processing =====
# Thumbnail long edge in pixels; webp quality 1-100.
THUMBNAIL_MAX_LONG_EDGE=720
THUMBNAIL_QUALITY=78

# ===== SSE =====
# Heartbeat keeps long connections alive through proxies; per-user cap
# protects against runaway tabs.
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_CONNECTIONS_PER_USER=4

# ===== Logging =====
# Root level for the txt2img.* loggers. DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# "json" for structured output (recommended); "text" for human-readable.
LOG_FORMAT=json
# Files are written under this directory. With the default ./data bind-mount
# they show up on the host at ./data/logs/backend/*.log .
LOG_DIR=/app/data/logs/backend
# Also stream to stdout so `docker compose logs` keeps working.
LOG_TO_STDOUT=true
# How many rotated copies of app.log to keep (one per day).
LOG_RETAIN_DAYS=30
# Rotation cadence — passed verbatim to TimedRotatingFileHandler.
LOG_ROTATE_WHEN=midnight
# Comma-separated case-insensitive field names that must be redacted before
# log records reach disk. Free to extend — defaults already cover JWT / api
# keys / captcha tokens.
LOG_REDACT_FIELDS=password,api_key,token,authorization,captcha_token,jwt,secret,refresh_token,access_token,client_secret
# 0 ⇒ never log request bodies. >0 truncates each body to N bytes.
LOG_REQUEST_BODY_MAX_BYTES=0
# Per-file kill switches.
LOG_ACCESS_ENABLED=true
LOG_ADAPTER_ENABLED=true
LOG_CLIENT_LOGS_ENABLED=true
# Frontend-side log channel limits.
LOG_CLIENT_LOGS_RATE_LIMIT=60
LOG_CLIENT_LOGS_RATE_LIMIT_ANON=30
LOG_CLIENT_LOGS_BATCH_MAX=50
LOG_CLIENT_LOGS_ITEM_MAX_BYTES=8192
# Probabilistic DEBUG sampling. 0 disables DEBUG completely.
LOG_SAMPLE_DEBUG=0.0
LOG_INCLUDE_TRACEBACK=true
