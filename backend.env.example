# Copy to backend.env on each server and fill in real values.
# Server-side only — do NOT commit the filled-in version to git.

# JWT secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=3650

# DB path is set in docker-compose to /app/data/txt2img.db, which maps to
# ./data/txt2img.db on the host (bind mount). Override only if you really need
# a different path.
# DB_URL=sqlite:////app/data/txt2img.db

# Bootstrap admin (created on first startup if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Force human verification on every login regardless of failure count
FORCE_CAPTCHA=false

# CORS origins. "*" = lenient (any origin), otherwise comma-separated list.
# With nginx same-origin proxy this is rarely hit anyway, but "*" lets LAN
# devices that bypass the proxy still talk to the backend.
CORS_ORIGINS=*
