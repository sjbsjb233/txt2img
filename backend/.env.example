# Copy to .env and fill in values.

# JWT secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=3650

# Database (SQLite file path resolved relative to backend/)
DB_URL=sqlite:///./txt2img.db

# Bootstrap admin (created on startup if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Force human verification on every login regardless of failure count
FORCE_CAPTCHA=false

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
